# Copy to .env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...

# Read/write connection used by the app.
DATABASE_URL=postgres://ts_app:ts_app_dev@127.0.0.1:5432/ts_workspace

# SELECT-only connection used by the assistant's sql_query tool. The database
# grant is what stops a write, not a check in application code.
DATABASE_URL_RO=postgres://ts_readonly:ts_readonly_dev@127.0.0.1:5432/ts_workspace

PORT=4000
