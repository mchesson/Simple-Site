---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { getIndustries } from '../lib';
const industries = await getIndustries();
const reasons = [
  ['Work That Matters', 'Join projects that build new facilities, bring capacity online and put new technology to work.'],
  ['A Team That Knows Your Field', 'Work with people who understand your craft and the standards you work to.'],
  ['Room to Grow', 'We invest in your development and help you find the next project that fits.'],
];
---
<Base title="Careers" description="Build your career on meaningful projects with Technical Source.">
  <Banner eyebrow="Careers" compact>
    <h1>Build your career on <span class="hl">meaningful projects.</span></h1>
    <p class="banner-sub">Join a team that knows your craft, invests in your growth and connects you to work worth doing.</p>
    <div class="row"><a class="btn btn-green" href="#jobs">Search Jobs</a><a class="btn btn-outline-light" href="#network">Stay in Touch</a></div>
  </Banner>

  <section class="sec">
    <div class="wrap">
      <span class="eyebrow">Why Technical Source</span>
      <h2>Why People Work with Us</h2>
      <div class="grid g3 reasons">{reasons.map(([t, b]) => <div class="card"><h3>{t}</h3><p>{b}</p></div>)}</div>
    </div>
  </section>

  <section class="sec mist" id="jobs">
    <div class="wrap">
      <span class="eyebrow">Open Positions</span>
      <h2>Search Jobs</h2>
      <form class="search" role="search" onsubmit="event.preventDefault()">
        <input id="job-q" aria-label="Job title or keyword" placeholder="Job title, skill or keyword" />
        <input id="job-loc" aria-label="Location" placeholder="Location" />
      </form>
      <p class="job-count" id="job-count" aria-live="polite">Loading open positions…</p>
      <ul class="jobs" id="job-list"></ul>
      <p class="job-empty" id="job-empty" hidden>
        We don’t have a posted opening that matches right now. Share your details below and we’ll reach out when a project fits your experience.
      </p>
    </div>
  </section>

  <section class="sec" id="network">
    <div class="wrap narrow">
      <span class="eyebrow">Stay in Touch</span>
      <h2>Not Looking Right Now?</h2>
      <p class="lede">Share your details and we’ll reach out when a project fits your experience.</p>
      <form class="form" action="/api/talent" method="post" data-form data-success="Thank you. We’ll reach out when a project fits your experience.">
        <div class="pair">
          <label>First name<input name="firstName" autocomplete="given-name" required /></label>
          <label>Last name<input name="lastName" autocomplete="family-name" required /></label>
        </div>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Industry
          <select name="industry" id="industry-select">{industries.map((i) => <option value={i.data.name} data-id={i.id}>{i.data.name}</option>)}</select>
        </label>
        <label>Your specialty<input name="specialty" placeholder="e.g. Validation Engineer, Commissioning Agent" /></label>
        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn btn-primary" type="submit">Submit</button>
        <p class="status" role="status" hidden></p>
      </form>
    </div>
  </section>
</Base>
<script>
  import '../scripts/forms.ts';

  // Preselect the visitor's industry in the signup form.
  const sel = document.querySelector<HTMLSelectElement>('#industry-select');
  const p = new URLSearchParams(location.search).get('industry') || document.documentElement.dataset.visitorIndustry;
  const opt = sel && p ? Array.from(sel.options).find((o) => o.dataset.id === p) : undefined;
  if (sel && opt) sel.value = opt.value;

  // Open positions from Crelate (/api/jobs), filtered as the visitor types.
  type Job = { id: string; title: string; location: string; type: string; summary: string; url: string };
  const list = document.getElementById('job-list')!;
  const count = document.getElementById('job-count')!;
  const empty = document.getElementById('job-empty')!;
  const q = document.getElementById('job-q') as HTMLInputElement;
  const loc = document.getElementById('job-loc') as HTMLInputElement;
  let jobs: Job[] = [];

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function render() {
    const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    const place = loc.value.toLowerCase().trim();
    const shown = jobs.filter((j) => {
      const text = `${j.title} ${j.summary} ${j.type}`.toLowerCase();
      return words.every((w) => text.includes(w)) && (!place || j.location.toLowerCase().includes(place));
    });
    list.innerHTML = shown
      .map((j) => `<li><a href="${esc(j.url || '#network')}"${j.url ? ' target="_blank" rel="noopener"' : ''}>
          <h3>${esc(j.title)}</h3>
          <p class="meta">${esc([j.location, j.type].filter(Boolean).join(' · '))}</p>
          ${j.summary ? `<p>${esc(j.summary)}</p>` : ''}
          <span class="go">${j.url ? 'View and Apply →' : 'Express Interest →'}</span></a></li>`)
      .join('');
    count.textContent = jobs.length ? `${shown.length} open position${shown.length === 1 ? '' : 's'}` : '';
    empty.hidden = shown.length > 0;
  }
  q.addEventListener('input', render);
  loc.addEventListener('input', render);

  fetch('/api/jobs')
    .then((r) => r.json())
    .then((out) => { jobs = Array.isArray(out.jobs) ? out.jobs : []; render(); })
    .catch(() => { jobs = []; render(); });
</script>
<style>
  .reasons { margin-top: 1.5rem; }
  .search { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.25rem; }
  .search input, .search select { flex: 1 1 12rem; padding: .8rem .9rem; border: 1px solid var(--light); border-radius: 6px; font: inherit; background: #fff; }
  .job-count { color: var(--muted); margin: 1.25rem 0 .75rem; font-size: .95rem; }
  .jobs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .jobs :global(li) { border-bottom: 1px solid var(--line); }
  .jobs :global(a) { display: block; padding: 1.4rem 0; text-decoration: none; color: inherit; }
  .jobs :global(a:hover h3) { color: var(--blue); }
  .jobs :global(h3) { margin: 0 0 .25rem; }
  .jobs :global(.meta) { color: var(--aqua-deep); font-weight: 600; font-size: .9rem; margin: 0 0 .5rem; }
  .jobs :global(p) { color: var(--muted); margin: 0 0 .5rem; }
  .jobs :global(.go) { color: var(--blue); font-weight: 600; }
  .job-empty { color: var(--muted); max-width: 44rem; }
  .narrow { max-width: 42rem; }
  .form { margin-top: 1.5rem; }
</style>
