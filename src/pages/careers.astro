---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { site } from '../data/site';
const reasons = [
  ['Work That Matters', 'Join projects that build new facilities, bring capacity online and put new technology to work.'],
  ['A Team That Knows Your Field', 'Work with people who understand your craft and the standards you work to.'],
  ['Room to Grow', 'We invest in your development and help you find the next project that fits.'],
];
---
<Base title="Careers" description="Build your career on meaningful projects with Technical Source.">
  <Banner eyebrow="Careers" compact>
    <h1>Build your career on <span class="hl">meaningful projects.</span></h1>
    <p class="banner-sub">Join a team that knows your craft, invests in your growth and connects you to work worth doing.</p>
    <div class="row"><a class="btn btn-green" href="#jobs">Search Jobs</a><a class="btn btn-outline-light" href="#network">Stay in Touch</a></div>
  </Banner>

  <section class="sec">
    <div class="wrap">
      <span class="eyebrow">Why Technical Source</span>
      <h2>Why People Work with Us</h2>
      <div class="grid g3 reasons">{reasons.map(([t, b]) => <div class="card"><h3>{t}</h3><p>{b}</p></div>)}</div>
    </div>
  </section>

  <section class="sec mist" id="jobs">
    <div class="wrap">
      <span class="eyebrow">Open Positions</span>
      <h2>Search Jobs</h2>
      <form class="search" role="search" id="job-search">
        <label class="visually-hidden" for="job-q">Keyword</label>
        <input id="job-q" name="q" placeholder="Job title, skill or keyword" />
        <label class="visually-hidden" for="job-loc">ZIP code or city</label>
        <input id="job-loc" name="loc" placeholder="ZIP code or City, ST" />
        <label class="visually-hidden" for="job-radius">Distance</label>
        <select id="job-radius" name="radius">
          <option value="10">Within 10 miles</option>
          <option value="25">Within 25 miles</option>
          <option value="50" selected>Within 50 miles</option>
          <option value="100">Within 100 miles</option>
          <option value="250">Within 250 miles</option>
          <option value="0">Any distance</option>
        </select>
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
      <p class="job-count" id="job-count" aria-live="polite">Loading open positions…</p>
      <ul class="jobs" id="job-list"></ul>
      <p class="job-empty" id="job-empty" hidden>
        No posted openings match your search. Try different words, or <a href="#network">send us your resume</a> and we’ll reach out when a project fits your experience.
      </p>
      <div class="job-portal" id="job-portal" hidden>
        <p>Browse our current openings and apply online.</p>
        <a class="btn btn-primary" href={site.jobsPortal} target="_blank" rel="noopener">View Open Positions →</a>
      </div>
    </div>
  </section>

  <section class="sec" id="network">
    <div class="wrap narrow">
      <span class="eyebrow">Stay in Touch</span>
      <h2>Not Looking Right Now?</h2>
      <p class="lede">Send us your resume and we’ll reach out when a project fits your experience.</p>
      <a class="btn btn-primary" href={site.resumeSubmitUrl || site.jobsPortal} target="_blank" rel="noopener">Submit Your Resume</a>
    </div>
  </section>
</Base>
<script>
  // Open positions from Crelate (/api/jobs): public portal postings only,
  // searched on the server by keyword and distance from a ZIP code or city.
  type Job = { title: string; location: string; summary: string; url: string; distance: number | null; remote: boolean };
  const list = document.getElementById('job-list')!;
  const count = document.getElementById('job-count')!;
  const empty = document.getElementById('job-empty')!;
  const form = document.getElementById('job-search') as HTMLFormElement;
  const portalBox = document.getElementById('job-portal')!;

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const meta = (j: Job) => [j.location, j.distance !== null && !j.remote ? `${j.distance} mi away` : ''].filter(Boolean).join(' · ');

  function show(jobs: Job[], note: string) {
    list.innerHTML = jobs
      .map((j) => `<li><a href="${esc(j.url)}">
          <h3>${esc(j.title)}</h3>
          ${meta(j) ? `<p class="meta">${esc(meta(j))}</p>` : ''}
          ${j.summary ? `<p>${esc(j.summary)}</p>` : ''}
          <span class="go">View and Apply →</span></a></li>`)
      .join('');
    count.textContent = note;
    empty.hidden = jobs.length > 0;
  }

  // No jobs from the API at all (list switched off, key missing, Crelate
  // unreachable, nothing posted): send visitors to the portal instead.
  function fallback() {
    form.hidden = true;
    count.hidden = true;
    portalBox.hidden = false;
  }

  async function search(first = false) {
    const params = new URLSearchParams();
    const fd = new FormData(form);
    for (const k of ['q', 'loc', 'radius']) { const v = String(fd.get(k) ?? '').trim(); if (v) params.set(k, v); }
    if (!params.get('loc')) params.delete('radius');
    count.textContent = 'Searching…';
    try {
      const out = await (await fetch(`/api/jobs?${params}`)).json();
      const jobs: Job[] = Array.isArray(out.jobs) ? out.jobs : [];
      if (first && !jobs.length) return fallback();
      if (out.error === 'bad-location') return show([], 'We couldn’t find that location. Try a 5-digit ZIP code or “City, ST”.');
      const r = params.get('radius');
      const where = out.origin ? (r === '0' ? ` near ${out.origin}` : ` within ${r} miles of ${out.origin}`) : '';
      show(jobs, `${jobs.length} open position${jobs.length === 1 ? '' : 's'}${where}`);
    } catch {
      if (first) fallback();
      else show([], 'Search isn’t available right now. Please try again shortly.');
    }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); search(); });
  search(true);
</script>
<style>
  .reasons { margin-top: 1.5rem; }
  .search { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.25rem; }
  .search .btn { flex: 0 0 auto; }
  .search input, .search select { flex: 1 1 12rem; padding: .8rem .9rem; border: 1px solid var(--light); border-radius: 6px; font: inherit; background: #fff; }
  .job-count { color: var(--muted); margin: 1.25rem 0 .75rem; font-size: .95rem; }
  .jobs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .jobs :global(li) { border-bottom: 1px solid var(--line); }
  .jobs :global(a) { display: block; padding: 1.4rem 0; text-decoration: none; color: inherit; }
  .jobs :global(a:hover h3) { color: var(--blue); }
  .jobs :global(h3) { margin: 0 0 .25rem; }
  .jobs :global(.meta) { color: var(--aqua-deep); font-weight: 600; font-size: .9rem; margin: 0 0 .5rem; }
  .jobs :global(p) { color: var(--muted); margin: 0 0 .5rem; }
  .jobs :global(.go) { color: var(--blue); font-weight: 600; }
  .job-empty { color: var(--muted); max-width: 44rem; margin-top: 1rem; }
  .job-portal { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; margin-top: .5rem; }
  .job-portal p { margin: 0; font-size: 1.15rem; color: var(--muted); }
  .search[hidden], .job-portal[hidden] { display: none; }
  .jobs:empty { border-top: 0; }
  .narrow { max-width: 42rem; }
  #network .btn { margin-top: .5rem; }
</style>
