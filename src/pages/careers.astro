---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { getIndustries } from '../lib';
const industries = await getIndustries();
const reasons = [
  ['Work that matters', 'Join projects that build new facilities, bring capacity online and put new technology to work.'],
  ['A team that knows your field', 'Work with people who understand your craft and the standards you work to.'],
  ['Room to grow', 'We invest in your development and help you find the next project that fits.'],
];
---
<Base title="Careers" description="Build your career on meaningful projects with Technical Source.">
  <Banner eyebrow="Careers" compact>
    <h1>Build your career on <span class="hl">meaningful projects.</span></h1>
    <p class="banner-sub">Join a team that knows your craft, invests in your growth and connects you to work worth doing.</p>
    <div class="row"><a class="btn btn-green" href="#jobs">Search Jobs</a><a class="btn btn-outline-light" href="#network">Stay in Touch</a></div>
  </Banner>

  <section class="sec">
    <div class="wrap">
      <span class="eyebrow">Why Technical Source</span>
      <h2>Why people work with us</h2>
      <div class="grid g3 reasons">{reasons.map(([t, b]) => <div class="card"><h3>{t}</h3><p>{b}</p></div>)}</div>
    </div>
  </section>

  <section class="sec mist" id="jobs">
    <div class="wrap">
      <span class="eyebrow">Open positions</span>
      <h2>Search jobs</h2>
      <form class="search" onsubmit="event.preventDefault(); this.querySelector('.note').hidden = false;">
        <input aria-label="Job title or keyword" placeholder="Job title, skill or keyword" />
        <select aria-label="Industry" id="industry-select">
          <option value="">All industries</option>
          {industries.map((i) => <option value={i.id}>{i.data.name}</option>)}
        </select>
        <input aria-label="Location" placeholder="Location" />
        <button class="btn btn-primary" type="submit">Search</button>
        <p class="note" hidden>Prototype only: open positions will load here from Crelate.</p>
      </form>
    </div>
  </section>

  <section class="sec" id="network">
    <div class="wrap narrow">
      <span class="eyebrow">Stay in touch</span>
      <h2>Not looking right now?</h2>
      <p class="lede">Share your details and we’ll reach out when a project fits your experience.</p>
      <form class="form" onsubmit="event.preventDefault(); this.querySelector('.note').hidden = false;">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Industry
          <select name="industry">{industries.map((i) => <option value={i.id}>{i.data.name}</option>)}</select>
        </label>
        <label>Your specialty<input name="specialty" placeholder="e.g. Validation Engineer, Commissioning Agent" /></label>
        <button class="btn btn-primary" type="submit">Submit</button>
        <p class="note" hidden>Prototype only: nothing was sent. At launch this goes to Crelate.</p>
      </form>
    </div>
  </section>
</Base>
<script>
  const sel = document.querySelector<HTMLSelectElement>('#industry-select');
  const p = new URLSearchParams(location.search).get('industry') || document.documentElement.dataset.visitorIndustry;
  if (sel && p && Array.from(sel.options).some((o) => o.value === p)) sel.value = p;
</script>
<style>
  .reasons { margin-top: 1.5rem; }
  .search { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.25rem; }
  .search input, .search select { flex: 1 1 12rem; padding: .8rem .9rem; border: 1px solid var(--light); border-radius: 6px; font: inherit; background: #fff; }
  .search .note { flex-basis: 100%; margin: 0; padding: .75rem 1rem; border-radius: 6px; background: #FFF6D6; color: #6B5300; font-size: .92rem; }
  .narrow { max-width: 42rem; }
  .form { margin-top: 1.5rem; }
</style>
