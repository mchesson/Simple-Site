---
import Base from '../layouts/Base.astro';
import { pillars } from '../data/pillars';
import { site } from '../data/site';
---
<Base title="Contact" description="Talk to Technical Source about your program.">
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Talk to us</p>
        <h1>Tell us about your program.</h1>
        <p class="lede">What you’re delivering, when, and where you’re short. We’ll come back with the right people, or the right team.</p>
        <ul class="chev-list info">
          <li>{site.city}</li>
          <li><a href={`tel:${site.phone.replace(/\D/g, '')}`}>{site.phone}</a></li>
          <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
      <form class="form card" id="contact-form" onsubmit="event.preventDefault(); this.querySelector('.note').hidden = false;">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Work email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Company<input name="company" autocomplete="organization" /></label>
        <label>Program type
          <select name="pillar" id="pillar-select">
            {pillars.map((p) => <option value={p.id}>{p.label}</option>)}
            <option value="other">Something else</option>
          </select>
        </label>
        <label>About the program<textarea name="message" rows="5" placeholder="Scope, timeline, roles you need"></textarea></label>
        <button class="btn btn--primary" type="submit">Send</button>
        <p class="note" hidden>Prototype only: nothing was sent. At launch, this creates a contact in Crelate tagged with the program type and source.</p>
      </form>
    </div>
  </section>
</Base>
<script>
  // Preselect the program from ?pillar= or the remembered pillar.
  const sel = document.querySelector<HTMLSelectElement>('#pillar-select');
  const p = new URLSearchParams(location.search).get('pillar') || document.documentElement.dataset.visitorPillar;
  if (sel && p && Array.from(sel.options).some((o) => o.value === p)) sel.value = p;
</script>
<style>
  .split { display: grid; gap: 3rem; grid-template-columns: 1fr 1fr; align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  h1 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); }
  .info { margin-top: 2rem; }
</style>
