---
import Base from '../layouts/Base.astro';
import Track from '../components/Track.astro';
import StoryGrid from '../components/StoryGrid.astro';
import Cta from '../components/Cta.astro';
import { pillars, differentiators, engagementModels, type Pillar } from '../data/pillars';
import { site } from '../data/site';
import { getStories } from '../lib';

export function getStaticPaths() {
  return pillars.map((p) => ({ params: { pillar: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: Pillar };
const all = await getStories();
const pillarStories = all.filter((s) => s.data.pillar === p.id);
const companyStories = all.filter((s) => s.data.pillar === 'company');
// Keep the umbrella story visible on every pillar page (the 70/30 rule).
const stories = [...pillarStories.slice(0, 5), ...companyStories.slice(0, 1)];
const others = pillars.filter((o) => o.id !== p.id);
// Each pillar hero uses one of the brand guide's gradients.
const heroGradient: Record<string, string> = {
  'life-sciences': 'linear-gradient(90deg, var(--aqua), var(--energy))',
  'data-centers': 'linear-gradient(90deg, var(--blue), var(--aqua))',
  'enterprise-technology': 'var(--spectrum)',
};
---
<Base title={p.label} description={p.pitch} pillar={p.id}>
  <section class="hero pillar-hero" style={`--c:${p.accent}; --hero-grad:${heroGradient[p.id]}`}>
    <div class="wrap">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1>{p.headline}</h1>
      <p class="lede">{p.pitch}</p>
      <div class="btn-row">
        <a class="btn btn--light" href={`/contact?pillar=${p.id}`}>Talk through your program <span aria-hidden="true">→</span></a>
        <a class="btn btn--outline-light" href={`/careers?pillar=${p.id}`}>{p.label} careers</a>
      </div>
      <p class="umbrella">{site.positioning}</p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Where we work in your program</p>
        <h2>From first plan to final sign-off.</h2>
        <p>We deliver specialists and teams at every phase, with the deepest bench where the schedule is most at risk.</p>
      </div>
      {p.tracks.map((t) => <Track track={t} accent={p.accent} />)}
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="section-head">
        <p class="eyebrow">Roles we deliver</p>
        <h2>Scarce specialists, already in our network.</h2>
        <p>These candidates aren’t on job boards. They know us because we invested in the relationship before the role opened.</p>
      </div>
      <ul class="roles">
        {p.roles.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why Technical Source</p>
        <h2>An execution partner, not a résumé service.</h2>
      </div>
      <div class="grid grid--4">
        {differentiators.map((d) => <div class="card"><h3>{d.title}</h3><p>{d.body}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Proof</p>
        <h2>Programs we’ve helped deliver</h2>
        <p>Case studies from {p.label} programs, anonymized where client agreements require it.</p>
      </div>
      <div class="grid grid--2">
        {p.proof.map((c) => (
          <div class="card placeholder"><span class="chip chip--sample">Placeholder</span><h3>{c.title}</h3><p>{c.detail}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <div class="section-head row">
        <div>
          <p class="eyebrow">Latest from {p.label}</p>
          <h2>News & insights</h2>
        </div>
        <a class="btn btn--ghost" href={`/news?pillar=${p.id}`}>All {p.label} stories</a>
      </div>
      <StoryGrid stories={stories} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How we engage</p>
        <h2>Start with specialists. Grow into managed delivery.</h2>
      </div>
      <ol class="tiers">
        {engagementModels.map((m) => <li><span class="chip">{m.status}</span><h3>{m.tier}</h3><p>{m.body}</p></li>)}
      </ol>
    </div>
  </section>

  <Cta pillar={p.id} />

  <section class="section other">
    <div class="wrap">
      <p class="eyebrow">Also from Technical Source</p>
      <div class="grid grid--2">
        {others.map((o) => (
          <a class="card other-card" href={`/${o.id}`} data-set-pillar={o.id} style={`--c:${o.accent}`}>
            <h3>{o.label}</h3><p>{o.cardLine}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .pillar-hero::after { background: var(--hero-grad); }
  .pillar-hero h1 { max-width: 20ch; font-size: clamp(2.1rem, 4.6vw, 3.5rem); }
  .umbrella {
    margin: 2.5rem 0 0; padding-top: 1.25rem; border-top: 1px solid #3D3D3D; max-width: 40rem;
    font-family: var(--font-head); font-style: italic; color: #BDBDBD;
  }
  .split { display: grid; gap: 3rem; grid-template-columns: 1fr 1.2fr; align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  .roles { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); }
  .roles li {
    display: flex; align-items: center; gap: 0.7rem; padding: 0.9rem 1.1rem;
    border: 1px solid var(--line); border-radius: 10px; font-weight: 600; font-size: 0.97rem;
  }
  .roles li::before {
    content: ''; flex: none; width: 0.65rem; height: 0.75rem; background: var(--blue-aqua);
    clip-path: polygon(0 0, 100% 50%, 0 100%, 34% 50%);
  }
  .placeholder { border-style: dashed; box-shadow: none; }
  .placeholder .chip { margin-bottom: 0.75rem; }
  .row { max-width: none; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; }
  .tiers { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .tiers li { border-top: 3px solid var(--line); padding-top: 1.25rem; }
  .tiers li:first-child { border-top-color: var(--blue); }
  .tiers .chip { margin-bottom: 0.75rem; }
  .tiers p { color: var(--muted); }
  .other { padding-top: 0; }
  .other-card { text-decoration: none; color: var(--ink); transition: border-color .15s; }
  .other-card:hover { border-color: var(--c); color: var(--ink); }
</style>
