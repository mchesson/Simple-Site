---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import IndustryRow from '../components/IndustryRow.astro';
---
<Base title="Page not found">
  <Banner compact>
    <h1>We couldn’t find <span class="hl">that page.</span></h1>
    <p class="banner-sub">Our website has a new look. Try one of these instead.</p>
    <div class="row"><a class="btn btn-green" href="/">Home</a><a class="btn btn-outline-light" href="/services">Services</a></div>
  </Banner>
  <IndustryRow />
</Base>
