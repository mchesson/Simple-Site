---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
const values = [
  ['Candor', 'Say what you mean, do what you say.'],
  ['Accountability', 'Own the commitments, the mistakes and the outcomes, every time.'],
  ['Excellence', 'Deliver on our promises and keep raising the bar.'],
  ['Enthusiasm', 'Show up with pride, purpose and a will to win.'],
  ['Humility', 'The best ideas win, regardless of who brought them.'],
];
---
<Base title="About" description="Technical Source's mission, vision and values.">
  <section class="hero">
    <div class="wrap">
      <p class="hero__tagline">{site.tagline}</p>
      <h1>We lead with industry knowledge.</h1>
      <p class="lede">For more than a decade we’ve brought the expertise to understand our clients’ problems, and the right people and teams to solve them.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap grid grid--2">
      <div>
        <p class="eyebrow">Mission</p>
        <p class="big">In engineering and technical fields where the work is complex, we bring the expertise to understand the client’s problem, and the right people and teams to solve it.</p>
      </div>
      <div>
        <p class="eyebrow">Vision</p>
        <p class="big">To become the go-to execution partner for organizations operating in complex and regulated industries, supporting our clients as they build what’s next.</p>
      </div>
    </div>
  </section>
  <section class="section section--mist">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Our promise</p>
        <h2>To our clients, and to the people we recruit.</h2>
      </div>
      <div class="grid grid--2">
        <div class="card"><h3>To our clients</h3><p>We know your industry, understand your goals, and bring the right people, or the right team, to move your work forward.</p></div>
        <div class="card"><h3>To those we recruit</h3><p>You join a team that knows your craft, invests in your growth, and connects you to work worth doing.</p></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Values</p><h2>How we show up. Every day.</h2></div>
      <div class="grid grid--3">
        {values.map(([t, b]) => <div class="card"><h3>{t}</h3><p>{b}</p></div>)}
      </div>
    </div>
  </section>
  <Cta />
</Base>
<style>
  .big { font-family: var(--font-head); font-size: clamp(1.3rem, 2.2vw, 1.65rem); line-height: 1.4; }
</style>
