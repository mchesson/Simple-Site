---
import StoryCard from './StoryCard.astro';
import type { Story } from '../lib';
interface Props { stories: Story[]; id?: string; sortByVisitor?: boolean }
const { stories, id, sortByVisitor = false } = Astro.props;
---
<ul class="story-grid" id={id} data-industry-sort={sortByVisitor ? '' : undefined}>
  {stories.map((s, i) => <StoryCard story={s} order={i} />)}
</ul>
<style>
  .story-grid { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 1.5rem 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
</style>
