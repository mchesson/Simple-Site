---
interface Props { title?: string; body?: string; pillar?: string; label?: string }
const {
  title = 'Have a program that can’t afford a missed handoff?',
  body = 'Tell us about the program, the timeline and where you’re short. We’ll come back with the people, or the team, to move it forward.',
  pillar,
  label = 'Talk through your program',
} = Astro.props;
const href = pillar ? `/contact?pillar=${pillar}` : '/contact';
---
<section class="cta">
  <div class="wrap inner">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--light" href={href}>{label} <span aria-hidden="true">→</span></a>
      <a class="btn btn--outline-light" href="/careers">Join Technical Source</a>
    </div>
  </div>
</section>
<style>
  .cta { background: linear-gradient(100deg, var(--blue-deep), var(--aqua-deep)); color: #fff; padding-block: clamp(3rem, 7vw, 5rem); }
  .inner { display: grid; gap: 2rem; align-items: center; grid-template-columns: 1.6fr 1fr; }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } }
  h2 { max-width: 22ch; }
  p { font-size: 1.1rem; max-width: 40rem; margin: 0; color: #F1FBFB; }
  .btn-row { justify-content: flex-end; }
  @media (max-width: 860px) { .btn-row { justify-content: flex-start; } }
</style>
