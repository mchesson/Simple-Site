---
interface Props { variant?: 'color' | 'white'; showTagline?: boolean }
const { variant = 'color', showTagline = true } = Astro.props;
import { site } from '../data/site';
---
<span class:list={['logo', `logo--${variant}`]}>
  <img src="/mark.svg" alt="" width="44" height="38" />
  <span class="logo__rule" aria-hidden="true"></span>
  <span class="logo__text">
    <span class="logo__name">{site.name}</span>
    {showTagline && <span class="logo__tag">{site.tagline}</span>}
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.75rem; color: #484849; }
  .logo img { width: 2.6rem; height: auto; }
  .logo__rule { width: 1px; align-self: stretch; background: var(--light); }
  .logo__text { display: grid; line-height: 1.1; }
  .logo__name { white-space: nowrap; font-family: var(--font-head); font-size: 1.45rem; letter-spacing: -0.005em; }
  .logo__tag { white-space: nowrap; font-size: 0.7rem; color: var(--ash); letter-spacing: 0.02em; margin-top: 0.2rem; }
  .logo--white { color: #fff; }
  .logo--white .logo__tag { color: var(--light); }
  .logo--white .logo__rule { background: #555; }
  @media (max-width: 420px) { .logo__tag, .logo__rule { display: none; } .logo__name { font-size: 1.25rem; } }
</style>
