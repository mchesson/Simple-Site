---
// Dark full-width banner used at the top of every page.
interface Props { tagline?: boolean; eyebrow?: string; compact?: boolean }
const { tagline = false, eyebrow, compact = false } = Astro.props;
import { site } from '../data/site';
---
<section class:list={['banner', { compact }]}>
  <div class="photo" aria-hidden="true"><slot name="photo" /></div>
  <div class="wrap banner-in">
    {tagline && <p class="tag">{site.tagline}</p>}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <slot />
  </div>
</section>
<style>
  .compact .banner-in { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .compact :global(h1) { font-size: clamp(2rem, 4vw, 3.1rem); max-width: 34ch; }
</style>
