---
import Logo from './Logo.astro';
import { pillars } from '../data/pillars';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap cols">
    <div class="about">
      <Logo variant="white" />
      <p>{site.positioning}</p>
    </div>
    <nav aria-label="Programs">
      <h2>Programs</h2>
      <ul>{pillars.map((p) => <li><a href={`/${p.id}`}>{p.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Company">
      <h2>Company</h2>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/how-we-engage">How We Engage</a></li>
        <li><a href="/news">News & Insights</a></li>
        <li><a href="/careers">Careers</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
    <div>
      <h2>Connect</h2>
      <ul>
        <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href="/news/rss.xml">News feed (RSS)</a></li>
        <li>{site.city}</li>
        <li><a href={`tel:${site.phone.replace(/\D/g, '')}`}>{site.phone}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} Technical Source. {site.tagline}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #D0D0D0; padding-top: 4rem; }
  .cols { display: grid; gap: 2.5rem; grid-template-columns: 2fr repeat(3, 1fr); }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .cols { grid-template-columns: 1fr; } }
  .about p { margin-top: 1.25rem; max-width: 26rem; color: #BDBDBD; }
  h2 { font-family: var(--font-body); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--energy); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; font-size: 0.95rem; }
  a { color: #E8E8E8; text-decoration: none; }
  a:hover { color: #fff; text-decoration: underline; }
  .legal { margin-top: 3rem; padding-bottom: 1.5rem; font-size: 0.85rem; color: #9A9A9A; }
  .legal p { margin: 0; padding-top: 1.5rem; border-top: 1px solid #3A3A3A; }
</style>
