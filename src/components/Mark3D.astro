---
// The chevron mark as a slowly turning 3D object (visual option A), used in
// the homepage banner. CSS 3D only: stacked copies of the chevron give it
// depth. It tilts toward the mouse, and holds still for visitors who turn on
// "reduce motion". Hidden on small phones, where the headline needs the room.
const depth = 18;
const layers = Array.from({ length: depth }, (_, i) => depth - i);
---
<div class="stage" aria-hidden="true" data-mark3d>
  <div class="glow"></div>
  <div class="tilt">
    <div class="mark">
      {layers.map((i) => <div class="layer" style={`transform:translateZ(${(-i * 1.6).toFixed(1)}px);background:hsl(${198 - i},70%,${26 + depth - i}%)`}></div>)}
      <div class="layer face"></div>
      <div class="layer shine"></div>
    </div>
  </div>
</div>
<script>
  // Tilt toward the pointer (desktop only; no effect on touch).
  document.querySelectorAll<HTMLElement>('[data-mark3d]').forEach((stage) => {
    const tilt = stage.querySelector<HTMLElement>('.tilt')!;
    const banner = stage.closest('section') ?? stage;
    banner.addEventListener('pointermove', (e) => {
      if ((e as PointerEvent).pointerType !== 'mouse') return;
      const r = stage.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / r.width));
      const y = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / r.height));
      tilt.style.transform = `rotateY(${x * 22}deg) rotateX(${-y * 16}deg)`;
    });
    banner.addEventListener('pointerleave', () => (tilt.style.transform = ''));
  });
</script>
<style>
  .stage { position: relative; height: 22rem; perspective: 900px; display: grid; place-items: center; }
  .glow { position: absolute; width: 20rem; height: 20rem; border-radius: 50%; background: radial-gradient(circle, rgb(0 186 180 / .35), transparent 65%); filter: blur(10px); }
  .tilt { transform-style: preserve-3d; transition: transform .3s ease-out; }
  .mark { position: relative; width: 15.5rem; height: 13.5rem; transform-style: preserve-3d; animation: turn 14s ease-in-out infinite; }
  .layer { position: absolute; inset: 0; clip-path: var(--chev); }
  .face { background: linear-gradient(90deg, var(--blue), var(--aqua)); }
  .shine { transform: translateZ(.5px); background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / .35) 45%, transparent 60%); background-size: 300% 100%; animation: shine 5s ease-in-out infinite; }
  @keyframes turn { 0%, 100% { transform: rotateY(-28deg) rotateX(8deg); } 50% { transform: rotateY(28deg) rotateX(-6deg); } }
  @keyframes shine { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } }
  @media (max-width: 900px) { .stage { height: 14rem; } .mark { width: 10rem; height: 8.7rem; } .glow { width: 13rem; height: 13rem; } }
  @media (max-width: 560px) { .stage { display: none; } }
  @media (prefers-reduced-motion: reduce) { .mark, .shine { animation: none; transform: rotateY(-18deg) rotateX(6deg); } .tilt { transition: none; } }
</style>
