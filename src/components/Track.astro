---
import type { Track } from '../data/pillars';
interface Props { track: Track; accent: string }
const { track, accent } = Astro.props;
const n = track.phases.length;
const cols = n % 3 === 0 || n === 5 ? 3 : n === 4 ? 4 : 2;
---
<div class="track" style={`--c:${accent}; --cols:${cols}`}>
  <h3>{track.title}</h3>
  <ol class:list={['phases', `phases--${track.kind}`]}>
    {track.phases.map((ph, i) => (
      <li class:list={{ hl: ph.highlight }}>
        {track.kind === 'lifecycle' && <span class="num">{String(i + 1).padStart(2, '0')}</span>}
        <h4>{ph.name}</h4>
        <p>{ph.detail}</p>
        <p class="roles"><strong>Roles</strong> {ph.roles}</p>
        {ph.highlight && <span class="flag">Core strength</span>}
      </li>
    ))}
  </ol>
</div>

<style>
  .track + :global(.track) { margin-top: 3rem; }
  h3 { font-size: 1.5rem; margin-bottom: 1.25rem; }
  .phases { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .phases { grid-template-columns: repeat(var(--cols), 1fr); }
  @media (max-width: 1000px) { .phases { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .phases { grid-template-columns: 1fr; } }
  li {
    position: relative; background: #fff; border: 1px solid var(--line); border-radius: 12px;
    padding: 1.25rem 1.25rem 1.1rem; display: flex; flex-direction: column;
  }
  .num { font-family: var(--font-head); font-size: 1.6rem; color: var(--light); line-height: 1; margin-bottom: 0.6rem; }
  h4 { font-family: var(--font-body); font-weight: 700; font-size: 1rem; margin: 0 0 0.4rem; }
  p { font-size: 0.92rem; color: var(--muted); margin: 0 0 0.6rem; }
  .roles { margin: auto 0 0; padding-top: 0.6rem; border-top: 1px dashed var(--line); font-size: 0.85rem; }
  .roles strong { display: block; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); }
  li.hl { background: var(--ink); border-color: var(--ink); color: #fff; }
  li.hl .num { color: var(--c); }
  li.hl p { color: #CFCFCF; }
  li.hl .roles { border-top-color: #444; }
  li.hl .roles strong { color: var(--energy); }
  .flag {
    position: absolute; top: 1rem; right: 1rem; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink); background: var(--energy); padding: 0.15rem 0.5rem; border-radius: 999px;
  }
</style>
