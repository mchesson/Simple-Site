---
// "Where We Work": header row, then one open column per industry, generated
// from src/content/industries. Styled like the "How We Work" steps (icon plus a
// fading line, no boxes) so it flows with the rest of the page. Columns adapt
// to the number of industries (3 across; 4 becomes 2 x 2; 5+ wraps in rows of 3).
import { getIndustries } from '../lib';
interface Props { heading?: string; intro?: string }
const {
  heading = 'Where We Work',
  intro = 'Specialized expertise for industries where precision, compliance and timing matter.',
} = Astro.props;
const industries = await getIndustries();
const n = industries.length;
const cols = n < 3 ? n : n === 4 ? 2 : 3;
---
<section class="ind-row">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="eyebrow">Industries</span>
        <h2>{heading}</h2>
        <p>{intro}</p>
      </div>
      <a class="all" href="/industries">View All Industries →</a>
    </div>

    <div class="cols" style={`--cols:${cols}`} data-industry-list>
      {industries.map((i) => (
        <a class="ind" href={`/industries/${i.id}`} data-industry={i.id} style={`--c:${i.data.color}`}>
          <span class="top" aria-hidden="true"><span class="chev"></span></span>
          <h3>{i.data.name}</h3>
          <p class="short">{i.data.short}</p>
          <ul class="focus">{i.data.focus.slice(0, 3).map((f) => <li>{f.title}</li>)}</ul>
          <span class="go">Learn More →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ind-row { background: var(--mist); padding-block: clamp(3.5rem, 7vw, 6rem); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 2rem; margin-bottom: 2.75rem; }
  .head h2 { margin-bottom: .4rem; }
  .head p { color: var(--muted); margin: 0; font-size: 1.1rem; max-width: 36rem; }
  .all { font-weight: 600; text-decoration: none; white-space: nowrap; }
  .all:hover { text-decoration: underline; }

  .cols { display: grid; gap: 2.5rem 3rem; grid-template-columns: repeat(var(--cols), 1fr); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; gap: 2.25rem; } }

  .ind { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .ind:hover { color: inherit; }
  .ind:hover h3 { color: var(--blue); }

  /* Icon followed by a fading line, echoing the How We Work steps */
  .top { display: flex; align-items: center; gap: .9rem; margin-bottom: 1.1rem; }
  .top .chev { width: 1.9rem; height: 1.65rem; }
  .top::after { content: ''; flex: 1; height: 2px; background: linear-gradient(90deg, var(--c), transparent); opacity: .6; }

  h3 { font-size: 1.45rem; margin: 0 0 .35rem; transition: color .15s; }
  .short { color: var(--muted); margin: 0 0 1rem; }
  .focus { list-style: none; margin: 0; padding: 0; display: grid; gap: .3rem; font-size: .93rem; color: var(--ink); }
  .focus li { position: relative; padding-left: 1rem; }
  .focus li::before { content: ''; position: absolute; left: 0; top: .62em; width: .35rem; height: .35rem; border-radius: 50%; background: var(--c); }
  .go { margin-top: auto; padding-top: 1.1rem; color: var(--blue); font-weight: 600; }
  @media (min-width: 901px) { .short { min-height: 3.3em; } }
</style>
