---
import { getEntry } from 'astro:content';
import { typeLabel, formatDate, photoOf, type Story } from '../lib';
import Photo from './Photo.astro';
interface Props { story: Story; order?: number }
const { story, order = 0 } = Astro.props;
const d = story.data;
const industry = d.industry ? await getEntry(d.industry) : undefined;
const kicker = industry ? industry.data.name : typeLabel[d.type];
---
<li class="story" data-industry={industry?.id ?? 'company'} data-order={order}>
  <a href={`/insights/${story.id}`}>
    <div class="photo thumb" aria-hidden="true"><Photo id={photoOf(story)} sizes="(max-width: 640px) 100vw, 400px" /></div>
    <div class="meta"><span class="kicker">{kicker}</span>{d.sample && <span class="chip">Sample</span>}</div>
    <h3>{d.title}</h3>
    <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
  </a>
</li>
<style>
  a { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  a:hover h3 { color: var(--blue); }
  .thumb { min-height: 10rem; margin-bottom: 1rem; }
  .kicker { font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--aqua-deep); }
  .meta { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  h3 { margin: .4rem 0 .5rem; }
  time { margin-top: auto; font-size: .85rem; color: var(--muted); }
</style>
