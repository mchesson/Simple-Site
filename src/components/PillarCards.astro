---
import { pillars } from '../data/pillars';
---
<ul class="pillar-cards" data-pillar-sort>
  {pillars.map((p, i) => (
    <li data-pillar={p.id} data-order={i} style={`--c:${p.accent}`}>
      <a href={`/${p.id}`} data-set-pillar={p.id}>
        <span class="yours">Your focus</span>
        <span class="mark" aria-hidden="true"></span>
        <h3>{p.label}</h3>
        <p class="short">{p.short}</p>
        <p>{p.cardLine}</p>
        <span class="go">Explore {p.label} <span aria-hidden="true">→</span></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .pillar-cards {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  a {
    position: relative; display: flex; flex-direction: column; height: 100%;
    padding: 1.75rem; border-radius: var(--radius);
    background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow);
    color: var(--ink); text-decoration: none; transition: transform .15s, box-shadow .15s, border-color .15s;
  }
  a:hover { transform: translateY(-3px); border-color: var(--c); color: var(--ink); }
  .mark {
    width: 2.2rem; height: 1.9rem; margin-bottom: 1.25rem; background: var(--c);
    clip-path: polygon(12.4% 0, 100% 50%, 12.4% 100%, 0 82.5%, 57% 50%, 0 17.5%);
  }
  h3 { font-size: 1.6rem; margin-bottom: 0.15rem; }
  .short { font-size: 0.85rem; font-weight: 600; color: var(--muted); letter-spacing: 0.02em; margin-bottom: 0.75rem; }
  p { color: var(--muted); }
  .go { margin-top: auto; font-weight: 600; color: var(--blue); }
  .yours {
    display: none; position: absolute; top: 1rem; right: 1rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    background: var(--ink); color: var(--energy); padding: 0.2rem 0.55rem; border-radius: 999px;
  }
  li:global(.is-yours) a { border-color: var(--c); box-shadow: 0 0 0 2px var(--c), var(--shadow); }
  li:global(.is-yours) .yours { display: inline-block; }
</style>
